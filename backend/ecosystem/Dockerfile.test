FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn[standard] pydantic httpx
COPY ecosystem/ /app/ecosystem/
COPY api/routes/ecosystem.py /app/api/routes/ecosystem.py
COPY api/routes/ecosystem_admin.py /app/api/routes/ecosystem_admin.py
COPY scripts/seed_ecosystem.py /app/scripts/seed_ecosystem.py
RUN touch /app/api/__init__.py /app/api/routes/__init__.py /app/scripts/__init__.py
ENV PYTHONPATH=/app
EXPOSE 8000
CMD ["sh", "-c", "uvicorn api.routes.ecosystem:router --host 0.0.0.0 --port ${PORT:-8000} --workers 1 2>/dev/null || python -c 'from fastapi import FastAPI; app=FastAPI(); @app.get(\"/health\"); def h(): return {\"status\":\"ok\"}; @app.get(\"/\"); def r(): return {\"service\":\"ecosystem-test\"}'"]
